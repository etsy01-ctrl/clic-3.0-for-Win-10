# Ignore .obj files, except wstub.obj (must be compiled with Borland Macro Assembler, not included)
*.obj
*.OBJ
!/src/clic/wstub.obj

# Backup IDE files
*.~DE

# Generated EXE and DLL files
*.EXE
*.DLL

# Generated ".res" files (from ".rc")
/src/clic/**/*.res

# Distribution files (provided in the "Releases" section)
/dist

# Non-redistributable tools
/tools/other


# Native Windows player
/build/
/src/clic.ini
/src/resources/assets/*.bgra
!/dist/
/dist/*
!/dist/ClicPlayer.exe
!/dist/CLIC.INI
*.map
*.tds
*.tmp
Thumbs.db
.DS_Store
.env
.env.*