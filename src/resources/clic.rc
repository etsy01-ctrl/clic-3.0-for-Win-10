#ifndef RUNTIME
MENU_PRINCIPAL MENU
BEGIN
	POPUP "&Archivo"
	BEGIN
#ifndef NOEDIT
		POPUP "&Nuevo..."
		BEGIN
			MENUITEM "&Rompecabezas", IDM_PUZZ
			MENUITEM "&Asociación", IDM_ASS
			MENUITEM "&Sopa de letras", IDM_SOP
			MENUITEM "&Crucigrama", IDM_CRW
			MENUITEM "Actividad de te&xto", IDM_TEXTACT
			MENUITEM SEPARATOR
			MENUITEM "&Paquete de actividades", IDM_PAQ
		END
#endif
		MENUITEM "&Abrir\tCtrl+F12", IDM_OPENFITX
		MENUITEM SEPARATOR
#ifndef NOEDIT
		MENUITEM "&Guardar\tMayúsculas+F12", IDM_SAVE, GRAYED
		MENUITEM "G&uardar como...\tF12", IDM_SAVEAS, GRAYED
		MENUITEM SEPARATOR
#endif
		MENUITEM "&Imprimir...", IDM_PRINT
		MENUITEM SEPARATOR
		MENUITEM "&Salir\tAlt+F4", IDM_EXIT
	END

#ifndef NOEDIT
	POPUP "&Edición"
	BEGIN
		MENUITEM "&Editar la actividad\tCtrl+E", IDM_EDITACT, GRAYED
		MENUITEM "Editar el &paquete de actividades\tCtrl+P", IDM_EDITPAC, GRAYED
	END
#endif
	POPUP "&Opciones"
	BEGIN
#ifndef NOEDIT
		MENUITEM "&Opciones de la actividad\tCtrl+O", IDM_ACTOPT, GRAYED
#endif
		MENUITEM "Opciones &globales\tCtrl+G", IDM_BARALLAT
	END

	POPUP "&Informes"
	BEGIN
		MENUITEM "&Informes del usuario actual\tCtrl+U", IDM_CLICDB
		MENUITEM "&Informe de la sesión actual\tCtrl+R", IDM_REPORT
		MENUITEM "&Empezar una nueva sesión", IDM_CLEARREP
		MENUITEM SEPARATOR
		MENUITEM "&Empezar con un nuevo usuario\tCtrl+N", IDM_NEWUSER
	END

	POPUP "&Ayuda", HELP
	BEGIN
		MENUITEM "&Índice", IDM_INDEX2
		MENUITEM "\277&Cómo funciona Clic?", IDM_HELPTIPUS
#ifndef NOEDIT
		MENUITEM "Creación y &modificación de actividades", IDM_HELPEDIT
#endif
		MENUITEM "&Otras funciones del programa", IDM_HELPCONFI
		MENUITEM SEPARATOR
		MENUITEM "&Uso de la ayuda de Windows", IDM_USTECLAT
		MENUITEM SEPARATOR
		MENUITEM "&Acerca de Clic...", IDM_INFO
	END
END
#endif

#ifdef RUNTIME
MENU_PRINCIPAL MENU
BEGIN
  POPUP "&Archivo"
  BEGIN
    MENUITEM "&Abrir juego...\tCtrl+O", IDM_OPENFITX
    MENUITEM "Vincular archivos .pcc...", IDM_ASSOCIATE_PCC
    MENUITEM SEPARATOR
    MENUITEM "Minimizar", IDM_MINIMIZE
    MENUITEM SEPARATOR
    MENUITEM "&Salir\tAlt+F4", IDM_EXIT
  END
  POPUP "&Actividad"
  BEGIN
    MENUITEM "&Reiniciar\tF5", IDFA_INICI
    MENUITEM "&Ayuda de la actividad\tF1", IDFA_AJUDA
    MENUITEM SEPARATOR
    MENUITEM "Opciones de puzzle...", BOTO_PUZZLE
    MENUITEM "Información de la actividad...", BOTO_INFO
    MENUITEM "Imprimir...", BOTO_PRINTER
  END
  POPUP "&Herramientas"
  BEGIN
    POPUP "&Apariencia"
    BEGIN
      MENUITEM "JClic clásico", IDM_SKIN_CLASSIC, CHECKED
      MENUITEM "Moderno", IDM_SKIN_MODERN
    END
  END
  POPUP "A&yuda"
  BEGIN
    MENUITEM "Acerca de Clic Player...", IDM_INFO
  END
END
#endif

