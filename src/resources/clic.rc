GLOBAL_ACC ACCELERATORS
BEGIN
#ifdef RUNTIME
    "O", IDM_OPENFITX, VIRTKEY, CONTROL
    "R", IDFA_INICI, VIRTKEY, CONTROL
    VK_F5, IDFA_INICI, VIRTKEY
    VK_F1, IDFA_AJUDA, VIRTKEY
    VK_LEFT, BOTO_ENRERE, VIRTKEY, CONTROL
    VK_RIGHT, BOTO_AVANT, VIRTKEY, CONTROL
#else
	VK_F12, IDM_OPENFITX, VIRTKEY, CONTROL
	"^G", IDM_BARALLAT
	"^R", IDM_REPORT
	"^U", IDM_CLICDB
	"^N", IDM_NEWUSER
	VK_F1, IDM_INDEX, VIRTKEY
	VK_F2, IDFA_INICI, VIRTKEY
	VK_F3, IDFA_AJUDA, VIRTKEY
	VK_F4, IDFA_INFO, VIRTKEY
#ifndef NOEDIT
	"^E", IDM_EDITACT
	"^O", IDM_ACTOPT
	VK_F12, IDM_SAVE, VIRTKEY, SHIFT
	VK_F12, IDM_SAVEAS, VIRTKEY
	"^P", IDM_EDITPAC
#endif
#endif
END


