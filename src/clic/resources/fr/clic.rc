#ifndef RUNTIME
MENU_PRINCIPAL MENU
BEGIN
	POPUP "&Fichier"
	BEGIN
#ifndef NOEDIT
		POPUP "&Nouveau..."
		BEGIN
			MENUITEM "&Puzzle", IDM_PUZZ
			MENUITEM "&Association", IDM_ASS
			MENUITEM "&Mots mélés", IDM_SOP
			MENUITEM "Mots &croisés", IDM_CRW
			MENUITEM "Activité de te&xte", IDM_TEXTACT
			MENUITEM SEPARATOR
			MENUITEM "&Groupe d'activités", IDM_PAQ
		END
#endif
		MENUITEM "&Ouvrir\tCtrl+F12", IDM_OPENFITX
		MENUITEM SEPARATOR
#ifndef NOEDIT
		MENUITEM "&Enregistrer\tMajuscules+F12", IDM_SAVE, GRAYED
		MENUITEM "E&nregistrer sous...\tF12", IDM_SAVEAS, GRAYED
		MENUITEM SEPARATOR
#endif
		MENUITEM "&Imprimer", IDM_PRINT
		MENUITEM SEPARATOR
		MENUITEM "&Quitter\tAlt+F4", IDM_EXIT
	END

#ifndef NOEDIT
	POPUP "&Edition"
	BEGIN
		MENUITEM "&Editer l'activité\tCtrl+E", IDM_EDITACT, GRAYED
		MENUITEM "Editer le &groupe d'activités\tCtrl+P", IDM_EDITPAC, GRAYED
	END
#endif
	POPUP "&Options"
	BEGIN
#ifndef NOEDIT
		MENUITEM "&Options de l'activité\tCtrl+O", IDM_ACTOPT, GRAYED
#endif
		MENUITEM "Options &générales\tCtrl+G", IDM_BARALLAT
	END

	POPUP "&Rapports"
	BEGIN
		MENUITEM "&Rapport de l'utilisateur actuel\tCtrl+U", IDM_CLICDB
		MENUITEM "Rapport de la &session en cours\tCtrl+R", IDM_REPORT
		MENUITEM "&Commencer une nouvelle session", IDM_CLEARREP
		MENUITEM SEPARATOR
		MENUITEM "Commencer avec un &nouvel utilisateur\tCtrl+N", IDM_NEWUSER
	END

	POPUP "&Aide", HELP
	BEGIN
		MENUITEM "&Index", IDM_INDEX2
		MENUITEM "&Comment fonctionne Clic?", IDM_HELPTIPUS
#ifndef NOEDIT
		MENUITEM "Création et &modification des activités", IDM_HELPEDIT
#endif
		MENUITEM "&Autres fonctions du programme", IDM_HELPCONFI
		MENUITEM SEPARATOR
		MENUITEM "&Utilisation de l'aide de Windows", IDM_USTECLAT
		MENUITEM SEPARATOR
		MENUITEM "A &propos de Clic...", IDM_INFO
	END
END
#endif

