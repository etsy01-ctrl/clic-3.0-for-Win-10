#ifndef RUNTIME
MENU_PRINCIPAL MENU
BEGIN
	POPUP "&Fitxers"
	BEGIN
#ifndef NOEDIT
		POPUP "&Nova activitat"
		BEGIN
			MENUITEM "&Trencaclosques", IDM_PUZZ
			MENUITEM "&Associació", IDM_ASS
			MENUITEM "&Sopa de lletres", IDM_SOP
			MENUITEM "&Mots encreuats", IDM_CRW
			MENUITEM "Activitat de te&xt", IDM_TEXTACT
			MENUITEM SEPARATOR
			MENUITEM "&Paquet d'activitats", IDM_PAQ
		END
#endif
		MENUITEM "&Obrir\tCtrl+F12", IDM_OPENFITX
		MENUITEM SEPARATOR
#ifndef NOEDIT
		MENUITEM "&Desar\tMajúscules+F12", IDM_SAVE, GRAYED
		MENUITEM "D&esar com a...\tF12", IDM_SAVEAS, GRAYED
		MENUITEM SEPARATOR
#endif
		MENUITEM "&Imprimir...", IDM_PRINT
		MENUITEM SEPARATOR
		MENUITEM "&Sortir\tAlt+F4", IDM_EXIT
	END

#ifndef NOEDIT
	POPUP "&Edició"
	BEGIN
		MENUITEM "&Editar l'activitat\tCtrl+E", IDM_EDITACT, GRAYED
		MENUITEM "Editar el &paquet d'activitats\tCtrl+P", IDM_EDITPAC, GRAYED
	END
#endif
	POPUP "&Opcions"
	BEGIN
#ifndef NOEDIT
		MENUITEM "&Opcions de l'activitat\tCtrl+O", IDM_ACTOPT, GRAYED
#endif
		MENUITEM "Opcions &globals\tCtrl+G", IDM_BARALLAT
	END

	POPUP "&Informes"
	BEGIN
		MENUITEM "&Informes de l'usuari actual\tCtrl+U", IDM_CLICDB
		MENUITEM "&Informe de la sessió actual\tCtrl+R", IDM_REPORT
		MENUITEM "&Començar una nova sessió", IDM_CLEARREP
		MENUITEM SEPARATOR
		MENUITEM "&Recomençar amb un nou usuari\tCtrl+N", IDM_NEWUSER
	END

	POPUP "&Ajuda", HELP
	BEGIN
		MENUITEM "&Índex", IDM_INDEX2
		MENUITEM "&Com funciona el Clic?", IDM_HELPTIPUS
#ifndef NOEDIT
		MENUITEM "Creació i modificació d'&activitats", IDM_HELPEDIT
#endif
		MENUITEM "&Altres funcions del programa", IDM_HELPCONFI
		MENUITEM SEPARATOR
		MENUITEM "&Ús de l'ajuda del Windows", IDM_USTECLAT
		MENUITEM SEPARATOR
		MENUITEM "&Crèdits", IDM_INFO
	END
END
#endif

