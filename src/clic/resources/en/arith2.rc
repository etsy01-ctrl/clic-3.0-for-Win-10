/* --------------------------------
	ARITH2.RC
	-------------------------------- */

#include "..\arith2\arithrc.h"

DIALEG_CONFIGURA DIALOG 6, 14, 343, 234
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION
CLASS "bordlg"
CAPTION "ARITH2.DLL Configuration"
FONT 8, "MS Sans Serif"
{
 CONTROL "OK", 1, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 88, 205, 37, 25
 CONTROL "CANCEL", 2, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 152, 205, 37, 25
 CONTROL "Button", IDHELP, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 216, 205, 37, 25
 CONTROL "Plus", IDC_SUM, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 11, 47, 51, 10
 CONTROL "Minus", IDC_REST, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 11, 60, 48, 10
 CONTROL "Multiply", IDC_MULT, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 11, 73, 52, 10
 CONTROL "Divide", IDC_DIV, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 11, 86, 38, 10
 CONTROL "A @ B = ?", IDC_ABX, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 10, 120, 48, 10
 CONTROL "A @ ? = C", IDC_AXC, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 10, 134, 51, 10
 CONTROL "? @ B = C", IDC_XBC, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 10, 148, 47, 10
 CONTROL "A ? B = C", IDC_AXBC, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 10, 162, 47, 10
 CONTROL "C = A @ B", IDC_CAXB, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 10, 180, 47, 10
 COMBOBOX IDC_LMINA, 99, 24, 41, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 COMBOBOX IDC_LMAXA, 152, 24, 41, 73, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 CONTROL "with", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 196, 26, 19, 8
 CONTROL "0", IDC_A0, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 214, 25, 21, 10
 CONTROL "1", IDC_A1, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 236, 25, 20, 10
 CONTROL "-1", IDC_A_1, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 258, 25, 19, 10
 CONTROL "One from the list:", IDC_CHLSA, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 81, 43, 69, 10
 EDITTEXT IDC_CHEDA, 150, 42, 125, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 CONTROL "Decimals:", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 288, 10, 39, 9
 CONTROL "# (integer)", IDC_AD0, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 288, 22, 46, 10
 CONTROL "#,#", IDC_AD1, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 288, 33, 32, 10
 CONTROL "#,##", IDC_AD2, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 288, 44, 32, 10
 COMBOBOX IDC_LMINB, 99, 85, 41, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 COMBOBOX IDC_LMAXB, 152, 85, 41, 71, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 CONTROL "with", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 196, 88, 19, 8
 CONTROL "0", IDC_B0, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 214, 87, 21, 10
 CONTROL "1", IDC_B1, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 236, 87, 20, 10
 CONTROL "-1", IDC_B_1, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 258, 87, 19, 10
 CONTROL "One from the list:", IDC_CHLSB, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 81, 107, 66, 10
 EDITTEXT IDC_CHEDB, 150, 106, 124, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
 CONTROL "# (integer)", IDC_BD0, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 289, 88, 46, 10
 CONTROL "#,#", IDC_BD1, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 289, 99, 32, 10
 CONTROL "#,##", IDC_BD2, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 289, 110, 32, 10
 COMBOBOX IDC_LMINR, 99, 145, 41, 76, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 COMBOBOX IDC_LMAXR, 152, 145, 41, 76, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 CONTROL "Do not carry", IDC_NOP, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 80, 163, 115, 12
 CONTROL "Random", IDC_NOSORT, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 201, 137, 60, 10
 CONTROL "Ascending", IDC_SORTASC, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 201, 150, 70, 10
 CONTROL "Descending", IDC_SORTDESC, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 201, 163, 74, 10
 CONTROL "Avoid duplicates", IDC_NOREP, "BorCheck", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 201, 180, 65, 10
 CONTROL "Indifferent", IDC_AIB, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 290, 151, 45, 10
 CONTROL "A > B", IDC_AGB, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 290, 165, 32, 10
 CONTROL "A < B", IDC_BGA, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 290, 179, 32, 10
 CONTROL "", -1, "BorShade", BSS_RGROUP | BSS_CAPTION | BSS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 5, 104, 66, 90
 CONTROL "", -1, "BorShade", BSS_RGROUP | BSS_CAPTION | BSS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 5, 32, 66, 68
 CONTROL "", -1, "BorShade", BSS_RGROUP | BSS_CAPTION | BSS_LEFT | WS_CHILD | WS_VISIBLE, 76, 5, 261, 56
 CONTROL "First operator", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 79, 11, 68, 8
 CONTROL "From", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 80, 27, 18, 8
 CONTROL "to", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 143, 26, 8, 8
 CONTROL "", -1, "BorShade", BSS_RGROUP | BSS_CAPTION | BSS_LEFT | WS_CHILD | WS_VISIBLE, 76, 69, 261, 56
 CONTROL "Second operator:", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 79, 73, 104, 8
 CONTROL "From", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 80, 88, 18, 8
 CONTROL "to", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 143, 88, 8, 8
 CONTROL "", -1, "BorShade", BSS_RGROUP | BSS_CAPTION | BSS_LEFT | WS_CHILD | WS_VISIBLE, 76, 131, 205, 63
 CONTROL "Result:", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 80, 135, 34, 8
 CONTROL "From", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 80, 149, 18, 8
 CONTROL "to", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 143, 148, 8, 8
 CONTROL "", -1, "BorShade", BSS_RGROUP | BSS_CAPTION | BSS_LEFT | WS_CHILD | WS_VISIBLE, 286, 131, 51, 62
 CONTROL "Conditions:", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 290, 138, 39, 9
 CONTROL "", -1, "BorShade", BSS_HDIP | BSS_LEFT | WS_CHILD | WS_VISIBLE, -1, 199, 345, 1
 CONTROL "Operations:", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 36, 41, 9
 CONTROL "Unknown:", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 11, 108, 38, 9
 CONTROL "", -1, "BorShade", BSS_HDIP | BSS_LEFT | WS_CHILD | WS_VISIBLE, 5, 175, 66, 2
 CONTROL "Logo", 0, "BorBtn", BBS_BITMAP | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 5, 66, 24
 CONTROL "Decimals:", -1, "BorStatic", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 289, 76, 39, 9
}


STRINGTABLE 
{
 IDS_NOOP, "ERROR: Must indicate at least one operation."
 IDS_ERRLIM, "ERROR: Wrong specification of numeric limits."
 IDS_NOINCOG, "ERROR:Must indicate at least one place for unknown quantity"
 IDS_INVACT, "ARITH.DLL cannot hold this type of activity"
 IDS_NOPORT, "Attention: numbers cannot be carried or borrowed unless they are used in additions and substractions with positive operators"
 IDS_BADVER, "ERROR: You are using an old version of ARITH2.DLL"
}


1000 BITMAP "../rcomu/logoarit.bmp"

