#ifndef RUNTIME
MENU_PRINCIPAL MENU
BEGIN
	POPUP "&данные"
	BEGIN
#ifndef NOEDIT
		POPUP "&новый..."
		BEGIN
			MENUITEM "&Головоломка", IDM_PUZZ
			MENUITEM "&Причисления", IDM_ASS
			MENUITEM "&Поиск с&лов", IDM_SOP
			MENUITEM "&Кроссворд - Эрудит", IDM_CRW
			MENUITEM "Те&кстовое упражнение", IDM_TEXTACT
			MENUITEM SEPARATOR
			MENUITEM "&Сборник упражнений", IDM_PAQ
		END
#endif
		MENUITEM "&Открыт\tCtrl+F12", IDM_OPENFITX
		MENUITEM SEPARATOR
#ifndef NOEDIT
		MENUITEM "Со&хранить\tпереключить+F12", IDM_SAVE, GRAYED
		MENUITEM "Сохранить &в низ...\tF12", IDM_SAVEAS, GRAYED
		MENUITEM SEPARATOR
#endif
		MENUITEM "&Печатать...", IDM_PRINT
		MENUITEM SEPARATOR
		MENUITEM "&закрыть\tAlt+F4", IDM_EXIT
	END

#ifndef NOEDIT
	POPUP "&Создан&ие - Изменение"
	BEGIN
		MENUITEM "Создание/Изменение упражнении", IDM_EDITACT, GRAYED
		MENUITEM "Создание/Изменение одного из паке&тов упражнениами\tCtrl+P",
IDM_EDITPAC, GRAYED
	END
#endif
	POPUP "&Оп&ции"
	BEGIN
#ifndef NOEDIT
		MENUITEM "&Опции для упра&жнения\tCtrl+O", IDM_ACTOPT, GRAYED
#endif
		MENUITEM "об&щие опции\tCtrl+G", IDM_BARALLAT
	END

	POPUP "&Отчет)"
	BEGIN
		MENUITEM "Отчет для актуального потре&бителя", IDM_CLICDB
		MENUITEM "Отчет для актуальных &упражнения\tCtrl+R", IDM_REPORT
		MENUITEM "Начало &новога упражнения", IDM_CLEARREP
		MENUITEM SEPARATOR
		MENUITEM "&Регистрация под другим именем\tCtrl+N", IDM_NEWUSER
	END

	POPUP "&Помощь", HELP
	BEGIN
		MENUITEM "&Индекс\tCtrl+U", IDM_INDEX2
		MENUITEM "Как &функционирует Clic?", IDM_HELPTIPUS
#ifndef NOEDIT
		MENUITEM "&Создание и изменение упражнений", IDM_HELPEDIT
#endif
		MENUITEM "&Дополнительные функции программ.", IDM_HELPCONFI
		MENUITEM SEPARATOR
		MENUITEM "Использование Windows-&помощь", IDM_USTECLAT
		MENUITEM SEPARATOR
		MENUITEM "Инф&ормация", IDM_INFO
	END
END
#endif

