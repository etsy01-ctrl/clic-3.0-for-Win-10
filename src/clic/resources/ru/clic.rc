#ifndef NOEDIT
DIALEG_EDIT_ASS DIALOG 10, 2, 288, 272
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CLASS "BorDlg"
CAPTION "Систематизирование  упражнений"
FONT 8, "Helv"
{
 CONTROL "OK", BOTO_OK, "BorBtn", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE |
WS_TABSTOP, 67, 241, 36, 24
