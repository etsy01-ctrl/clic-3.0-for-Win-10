#ifndef RUNTIME
MENU_PRINCIPAL MENU
BEGIN
	POPUP "&Fitxategia"
	BEGIN
#ifndef NOEDIT
		POPUP "&Berria..."
		BEGIN
			MENUITEM "&Buruhausgarria", IDM_PUZZ
			MENUITEM "&Elkarketa", IDM_ASS
			MENUITEM "&Letra zopa", IDM_SOP
			MENUITEM "&Gurutzegrama", IDM_CRW
			MENUITEM "Te&stu ariketa ", IDM_TEXTACT
			MENUITEM SEPARATOR
			MENUITEM "&Ariketen paketea", IDM_PAQ
		END
#endif
		MENUITEM "&Ireki\tKtrl+F12", IDM_OPENFITX
		MENUITEM SEPARATOR
#ifndef NOEDIT
		MENUITEM "&Gorde\tMaiuskulak+F12", IDM_SAVE, GRAYED
		MENUITEM "G&orde honela...\tF12", IDM_SAVEAS, GRAYED
		MENUITEM SEPARATOR
#endif
		MENUITEM "&Inprimatu...", IDM_PRINT
		MENUITEM SEPARATOR
		MENUITEM "&Irten\tAlt+F4", IDM_EXIT
	END

#ifndef NOEDIT
	POPUP "&Edizioa"
	BEGIN
		MENUITEM "&Ariketa editatu\tKtrl+E", IDM_EDITACT, GRAYED
		MENUITEM "Ariketen &paketea editatu\tKtrl+P", IDM_EDITPAC, GRAYED
	END
#endif
	POPUP "&Aukerak"
	BEGIN
#ifndef NOEDIT
		MENUITEM "&Ariketaren aukerak\tKtrl+O", IDM_ACTOPT, GRAYED
#endif
		MENUITEM "Aukera &orokorrak\tKtrl+G", IDM_BARALLAT
	END

	POPUP "&Txostenak"
	BEGIN
		MENUITEM "&Oraingo erabiltzailearen informeak", IDM_CLICDB
		MENUITEM "&Oraingo saioaren txostena\tKtrl+R", IDM_REPORT
		MENUITEM "&Saio berria hasi", IDM_CLEARREP
		MENUITEM SEPARATOR
		MENUITEM "&Beste erabiltzailea hasi\tKtrl+N", IDM_NEWUSER
	END

	POPUP "&Laguntza", HELP
	BEGIN
		MENUITEM "&Aurkibidea", IDM_INDEX2
		MENUITEM "&Nola dabil Klik?", IDM_HELPTIPUS
#ifndef NOEDIT
		MENUITEM "Ariketak &sortu eta aldatu", IDM_HELPEDIT
#endif
		MENUITEM "&Programaren beste funtzioak", IDM_HELPCONFI
		MENUITEM SEPARATOR
		MENUITEM "&Windows-en &laguntzaren erabilpena", IDM_USTECLAT
		MENUITEM SEPARATOR
		MENUITEM "&Kliki buruz...", IDM_INFO
	END
END
#endif

