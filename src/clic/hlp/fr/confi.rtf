\ql \li0\ri0\nowidctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \f1\fs20\lang1027\langfe3082\cgrid\langnp1027\langfenp3082 {\lang1024\langfe1024\noproof + 240}}}{\fs10 
\par }\pard\plain \s1\ql \li0\ri113\keepn\nowidctlpar\hyphpar0\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin113\lin0\itap0 \b\f1\fs28\cf2\lang1027\langfe3082\cgrid\langnp1027\langfenp3082 {\b0\fs20\uldb \{bmr mapa.bmp\}}{\b0\v\fs20 MAPA_CONFIG>wmapa}{
\fs20\up6  \{bmc clic.bmp\}   }{Caract\'e9ristiques du syst\'e8me d'automatisation d'activit\'e9
\par }\pard\plain \ql \li0\ri0\keepn\nowidctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \f1\fs20\lang1027\langfe3082\cgrid\langnp1027\langfenp3082 {\ul Voir aussi...}{\v MORE_HELP_TECHAUTO}{
