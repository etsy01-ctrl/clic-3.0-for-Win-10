\par \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\lang3082 \row }\trowd \trgaph70\trleft-70 \clvertalt\cltxlrtb \cellx2127\clvertalt\cltxlrtb \cellx8574\pard \nowidctlpar\intbl\hyphpar0\adjustright {\b\fs24\cf10\lang3082 Retardo}{\lang3082 \cell 
