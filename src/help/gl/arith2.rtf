\par 
\par {\pntext\pard\plain\b\f1\fs28\lang1027\langfe3082\langnp1027 \hich\af1\dbch\af0\loch\f1 -\tab}}\pard \ql \fi-360\li360\ri0\nowidctlpar\jclisttab\tx360{\*\pn \pnlvlblt\ilvl0\ls1\pnrnot0\pnb1\pnfs28\pnindent360\pnsp120\pnhang{\pntxtb -}}
