\ql \li0\ri0\nowidctlpar\intbl\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0 \f1\fs20\lang1027\langfe3082\cgrid\langnp1027\langfenp3082 {\lang2057\langfe3082\langnp2057 
