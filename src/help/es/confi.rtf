\par }{\lang3082 
\par Este archivo contiene las declaraciones de todas las variables, constantes y funciones necesarias para programar una DLL que se avenga con el sistema de generaci\'f3n autom\'e1tica de actividades:
\par 
\par }{\f2\lang1024 /* ----------------------------
\par    AUTOCLIC.H
\par    ---------------------------- */
\par 
\par #ifndef __AUTOCLIC_H__
\par #define __AUTOCLIC_H__
\par 
\par #include <windows.h>
\par 
\par #define CLIC_DLL_VERSION 0x100
\par 
\par #if defined( __cplusplus )
\par extern "C" \{
\par #endif  /* __cplusplus */
\par 
\par enum PlayModes \{NINGUNO, PUZZLE, SOPA, ASOCIA, CRUCIGRAMA\};
\par enum PuzModes  \{INTERCAMBIO, AGUJERO, DOBLE, MEMORIA\};
\par enum AssModes  \{NORMAL, ESPECIAL, EXPLORA, INFO, IDENTIFICA, ESCRIBE\};
\par enum GraPositions \{AB, BA, AUB, BUA\};
\par 
\par typedef struct tagActData
\par \{  int   clicVersion;
\par    LPINT actMode;
\par    LPINT actType;
\par    LPINT arrayPos;
\par    LPINT rows;
\par    LPINT columns;
\par    LPINT rows2;
\par    LPINT columns2;
\par    LPINT assignAss;
\par    LPINT ass;
\par    LPSTR initMessage;
\par    LPSTR endMessage;
\par    LPSTR tempFName[3];
\par    BOOL  useTempFName[3];
\par \} ACTDATA;
\par typedef ACTDATA FAR* LPACTDATA;
\par 
\par #define DLL_OPTIONS_SIZE 250
\par 
\par BOOL FAR PASCAL RemakeAct(LPSTR fileNameAct, LPACTDATA lpAct, LPSTR lpOps);
\par int FAR PASCAL GetClicDllVer();
\par BOOL FAR PASCAL ConfigureDllOptions(HWND hOwner, LPACTDATA lpAct, LPSTR lpOps);
\par BOOL FAR PASCAL IsValidAct(HWND hOwner, LPACTDATA lpAct, BOOL showMsg);
\par 
\par #if defined( __cplusplus )
\par \}
\par #endif  /* __cplusplus */
\par 
\par #endif  /* __AUTOCLIC_H__ */
\par }{\lang3082 
\par 
\par }{\cs16\b\fs24\cf2\lang3082\super #{\footnote \pard\plain \s15\nowidctlpar\hyphpar0\adjustright \f1\fs20\lang1027\cgrid {\cs16\lang1024\super #}{\lang1024  DLL_VARS}}}{\b\fs24\cf2\lang3082 Variables
