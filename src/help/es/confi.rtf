\par }{\cs16\b\lang3082\super #{\footnote \pard\plain \s15\nowidctlpar\hyphpar0\adjustright \f1\fs20\lang1027\cgrid {\cs16\lang1024\super #}{\lang1024  DLL_RA}}}{\b\lang3082 BOOL FAR PASCAL RemakeAct(LPSTR fileNameAct, LPACTDATA lpAct, LPSTR lpOps)
