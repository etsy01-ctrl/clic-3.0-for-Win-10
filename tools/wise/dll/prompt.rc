PROMPTDLG DIALOG DISCARDABLE  90, 50, 185, 156
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Select Install Options"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Select Installation Type:",IDC_STATIC,4,6,172,72
    CONTROL         "Complete Installation",IDC_COMPLETE_INSTALL,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,11,19,133,14
    CONTROL         "Network Installation",IDC_NETWORK_INSTALL,"Button",
                    BS_AUTORADIOBUTTON,11,36,133,14
    CONTROL         "Minimum Installation",IDC_MINIMUM_INSTALL,"Button",
                    BS_AUTORADIOBUTTON,11,53,133,14
    LTEXT           "Select Destination Directory:",IDC_STATIC,4,81,98,9
    EDITTEXT        IDC_PATHNAME,4,95,172,13,ES_AUTOHSCROLL
    CTEXT           "Press OK to continue.\nPress Cancel to abort the installation.",
                    IDC_STATIC,10,114,162,19
    DEFPUSHBUTTON   "OK",IDOK,6,136,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,127,136,50,14
END

