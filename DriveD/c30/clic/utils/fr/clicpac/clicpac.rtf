\f1\fs20\lang1027\langfe3082\cgrid\langnp1027\langfenp3082 {\cs16\lang2057\langfe3082\super\langnp2057 #}{\lang2057\langfe3082\langnp2057  COPIA}}+{\footnote \pard\plain 
