\par }\pard \fi-425\li709\nowidctlpar\tx709\hyphpar0\adjustright {\fs24 \{bmc bola.bmp\} }{\fs24\uldb Qu\'e8 fa el ClicPac?}{\v\fs24 QUEFA}{\fs24 
