\pard\plain \s15\ql \li0\ri0\nowidctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \f1\fs20\lang1027\langfe3082\cgrid\langnp1027\langfenp3082 {\cs16\lang2057\langfe3082\super\langnp2057 +}{\lang2057\langfe3082\langnp2057  CF:0070}}$
{\footnote \pard\plain \s15\ql \li0\ri0\nowidctlpar\hyphpar0\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \f1\fs20\lang1027\langfe3082\cgrid\langnp1027\langfenp3082 {\cs16\lang2057\langfe3082\super\langnp2057 $}{\lang2057\langfe3082\langnp2057 
