#ifndef RUNTIME
MENU_PRINCIPAL MENU
BEGIN
	POPUP "&File"
	BEGIN
#ifndef NOEDIT
		POPUP "&New..."
		BEGIN
			MENUITEM "&Puzzle", IDM_PUZZ
			MENUITEM "&Association", IDM_ASS
			MENUITEM "&Word Search", IDM_SOP
			MENUITEM "&Crossword", IDM_CRW
			MENUITEM "Te&xt activity", IDM_TEXTACT
			MENUITEM SEPARATOR
			MENUITEM "Ac&tivity pack", IDM_PAQ
		END
#endif
		MENUITEM "&Open\tCtrl+F12", IDM_OPENFITX
		MENUITEM SEPARATOR
#ifndef NOEDIT
		MENUITEM "&Save\tShift+F12", IDM_SAVE, GRAYED
		MENUITEM "S&ave as...\tF12", IDM_SAVEAS, GRAYED
		MENUITEM SEPARATOR
#endif
		MENUITEM "&Print...", IDM_PRINT
		MENUITEM SEPARATOR
		MENUITEM "&Exit\tAlt+F4", IDM_EXIT
	END

#ifndef NOEDIT
	POPUP "&Edit"
	BEGIN
		MENUITEM "&Edit activity\tCtrl+E", IDM_EDITACT, GRAYED
		MENUITEM "Edit &activity pack\tCtrl+P", IDM_EDITPAC, GRAYED
	END
#endif
	POPUP "&Options"
	BEGIN
#ifndef NOEDIT
		MENUITEM "&Activity options\tCtrl+O", IDM_ACTOPT, GRAYED
#endif
		MENUITEM "&Global options\tCtrl+G", IDM_BARALLAT
	END

	POPUP "&Reports"
	BEGIN
		MENUITEM "&Current user report\tCtrl+U", IDM_CLICDB
		MENUITEM "&Show current report\tCtrl+R", IDM_REPORT
		MENUITEM "&Begin new session", IDM_CLEARREP
		MENUITEM SEPARATOR
		MENUITEM "&New user\tCtrl+N", IDM_NEWUSER
	END

	POPUP "&Help", HELP
	BEGIN
		MENUITEM "&Contents", IDM_INDEX2
		MENUITEM "&How does Clic work?", IDM_HELPTIPUS
#ifndef NOEDIT
		MENUITEM "C&reating and modifying activities", IDM_HELPEDIT
#endif
		MENUITEM "Ad&vanced options", IDM_HELPCONFI
		MENUITEM SEPARATOR
		MENUITEM "&Using Windows help", IDM_USTECLAT
		MENUITEM SEPARATOR
		MENUITEM "A&bout ...", IDM_INFO
	END
END
#endif

