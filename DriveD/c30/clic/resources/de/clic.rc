#ifndef RUNTIME
MENU_PRINCIPAL MENU
BEGIN
	POPUP "&Datei"
	BEGIN
#ifndef NOEDIT
		POPUP "&Neu..."
		BEGIN
			MENUITEM "&Puzzle", IDM_PUZZ
			MENUITEM "&Zuordnungen", IDM_ASS
			MENUITEM "&Wörter suchen", IDM_SOP
			MENUITEM "&Kreuzworträtsel", IDM_CRW
			MENUITEM "Te&xtübung", IDM_TEXTACT
			MENUITEM SEPARATOR
			MENUITEM "&Sammlung von Übungen", IDM_PAQ
		END
#endif
		MENUITEM "Ö&ffnen\tStrg+F12", IDM_OPENFITX
		MENUITEM SEPARATOR
#ifndef NOEDIT
		MENUITEM "&Speichern\tUmschalt+F12", IDM_SAVE, GRAYED
		MENUITEM "Speichern &unter...\tF12", IDM_SAVEAS, GRAYED
		MENUITEM SEPARATOR
#endif
		MENUITEM "&Drucken", IDM_PRINT
		MENUITEM SEPARATOR
		MENUITEM "S&chließen\tAlt+F4", IDM_EXIT
	END

#ifndef NOEDIT
	POPUP "B&earbeiten"
	BEGIN
		MENUITEM "B&earbeiten einer Uebung\tStrg+E", IDM_EDITACT, GRAYED
		MENUITEM "Bearbeiten einer &Sammlung von Uebungen\tStrg+P", IDM_EDITPAC, GRAYED
	END
#endif
	POPUP "&Optionen"
	BEGIN
#ifndef NOEDIT
		MENUITEM "Optionen für eine Ü&bung\tStrg+O", IDM_ACTOPT, GRAYED
#endif
		MENUITEM "&allgemeine Optionen\tStrg+G", IDM_BARALLAT
	END

	POPUP "&Berichte"
	BEGIN
		MENUITEM "Bericht über den aktuellen &Benutzer\tStrg+U", IDM_CLICDB
		MENUITEM "Bericht über die aktuelle &Übung\tStrg+R", IDM_REPORT
		MENUITEM "Beginn einer &neuen Übung", IDM_CLEARREP
		MENUITEM SEPARATOR
		MENUITEM "Unter anderem Namen &anmelden\tStrg+N", IDM_NEWUSER
	END

	POPUP "&Hilfe", HELP
	BEGIN
		MENUITEM "&Index", IDM_INDEX2
		MENUITEM "Wie &funktioniert Clic?", IDM_HELPTIPUS
#ifndef NOEDIT
		MENUITEM "&Erstellen und Ändern von Übungen", IDM_HELPEDIT
#endif
		MENUITEM "&Weitere Funktionen des Programms", IDM_HELPCONFI
		MENUITEM SEPARATOR
		MENUITEM "Verwendung der Windows-&Hilfe", IDM_USTECLAT
		MENUITEM SEPARATOR
		MENUITEM "Inf&o", IDM_INFO
	END
END
#endif

