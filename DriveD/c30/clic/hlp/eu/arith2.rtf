\par }{\lang1034 \page }{\cs16\b\fs16\cf2\lang1034\super #{\footnote \pard\plain \s15\nowidctlpar\hyphpar0\adjustright \f1\fs20\lang1027 {\cs16\super #}{ TOPIC_NOPORT}}}{\b\fs16\cf2\lang1034 
